{
  "name": "zb-interieur",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,cyan \"vite\" \"npm run media-api\"",
    "dev:web": "vite",
    "media-api": "tsx server/local-server.ts",
    "build": "tsc -b && vite build && node scripts/spa-fallback.mjs",
    "lint": "oxlint",
    "preview": "concurrently -k -n web,api -c magenta,cyan \"vite preview\" \"npm run media-api\"",
    "netlify:build": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@netlify/blobs": "^11.1.3",
    "hono": "^4.13.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.13.1",
    "@supabase/supabase-js": "^2.58.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.2",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
