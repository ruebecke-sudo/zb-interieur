# Image Manager Pro – Environment Variables
# Example only. Never commit real secret values.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# ZB Interieur connector – server only
ZB_IMAGE_MANAGER_API_KEY=YOUR_ZB_API_KEY

# Stripe – server only
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_PRICE_LIFETIME=YOUR_STRIPE_PRICE_ID
STRIPE_PRICE_STARTER=YOUR_STRIPE_PRICE_ID
STRIPE_PRICE_PROFESSIONAL=YOUR_STRIPE_PRICE_ID
STRIPE_PRICE_BUSINESS=YOUR_STRIPE_PRICE_ID
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# Outbound German invitation emails – server only
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=Image Manager Pro <noreply@your-verified-domain.de>
